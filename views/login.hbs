<main class="auth-shell">
  <section class="auth-card shadow-sm">

    <h1 class="h3 fw-semibold">Welcome back</h1>
    <p class="text-secondary mb-4">Sign in to continue chatting.</p>

    {{#if error}}
      <div class="alert alert-danger py-2">{{error}}</div>
    {{/if}}

    <form method="post" action="/login" class="d-grid gap-3">
      <div>
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" type="email" class="form-control form-control-lg" value="{{form.email}}" required>
      </div>
      <div>
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control form-control-lg" required>
      </div>
      <button class="btn btn-primary btn-lg" type="submit">Login</button>
    </form>

    <p class="text-center text-secondary mt-4 mb-0">
      New here? <a href="/register">Create an account</a>
    </p>
  </section>
</main>
